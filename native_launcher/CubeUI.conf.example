# Copy to ~/.config/gvrmod/CubeUI.conf to override project defaults.
#
# view_lock=0  — world-locked panel (default). 1 = head-follow HUD.
# passthrough=1 — alpha-blend / FB passthrough when available
# grab_thresh  — squeeze to move menu
# panel_*      — size / seed pose (meters)

panel_dist=1.05
panel_w=0.84
panel_h=0.48
panel_x=0.0
panel_y=0.0
panel_z=0.0
view_lock=0
passthrough=1
panel_alpha=0.96
grab_thresh=0.55
