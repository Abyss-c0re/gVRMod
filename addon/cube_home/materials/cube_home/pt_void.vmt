// Source-engine missing-texture pink (error mosaic bright cell).
// RGB (255, 0, 220) = #FF00DC — used as chroma key for XR home passthrough.
// Do not use this color on props/avatars while passthrough is on.
"UnlitGeneric"
{
	"$basetexture" "vgui/white"
	"$color" "[1 0 0.863]"
	"$color2" "[1 0 0.863]"
	"$model" "1"
	"$nofog" "1"
	"$ignorez" "0"
	"$nocull" "1"
	"$vertexcolor" "0"
	"$vertexalpha" "0"
}
