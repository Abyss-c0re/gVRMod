// Pure green void key for XR passthrough chroma.
// Only this color is punched transparent — models keep normal shading.
// Do not use pure green on props/avatars if passthrough is on.
"UnlitGeneric"
{
	"$basetexture" "vgui/white"
	"$color" "[0 1 0]"
	"$color2" "[0 1 0]"
	"$model" "1"
	"$nofog" "1"
	"$ignorez" "0"
	"$nocull" "1"
	"$vertexcolor" "0"
	"$vertexalpha" "0"
}
