#!/usr/bin/env bash
# gVRMod pre-commit: if the addon submodule working tree is dirty, commit it and stage the pointer.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

SUB="$ROOT/addon/vrmod-x64"
if [[ ! -d "$SUB" ]]; then
  exit 0
fi

# Submodule uses a .git *file* (gitdir: ...); always use git -C "$SUB".
if ! git -C "$SUB" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  exit 0
fi

DIRTY=0
if ! git -C "$SUB" diff --quiet 2>/dev/null; then DIRTY=1; fi
if ! git -C "$SUB" diff --cached --quiet 2>/dev/null; then DIRTY=1; fi

# Parent staged a pointer bump only — fine
if [[ $DIRTY -eq 0 ]]; then
  exit 0
fi

echo "[pre-commit] addon/vrmod-x64 dirty — committing submodule..."
git -C "$SUB" add -A
if ! git -C "$SUB" diff --cached --quiet 2>/dev/null; then
  git -C "$SUB" commit -m "chore: update addon (pre-commit)" || true
fi
# Stage new submodule SHA on parent
git add "$SUB"
echo "[pre-commit] submodule pointer staged."
exit 0
